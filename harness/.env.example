# ==============================================================================
# Antigravity Harness Environment Configuration Template
# ==============================================================================
# This template documents all required and optional runtime environment
# variables for Everything-as-Code (ECC) hook bootstrap resolution, profile
# gating, governance audit capture, and session tracking within the agy-os harness.
#
# Copy this file to '.env' in the harness root (d:/dev/agy-os/.env) to activate.
# ==============================================================================

# ------------------------------------------------------------------------------
# Mandatory ECC In-Place Plugin Root Path Resolution
# ------------------------------------------------------------------------------
# Purpose: Establishes in-place module resolution for ECC hook bootstrap resolvers
# (e.g., plugin-hook-bootstrap.js, run-with-flags.js, resolve-ecc-root.js).
#
# In-Place Resolution Targets:
# - Hook scripts resolved from: ECC/scripts/hooks/ (26 selected hooks)
# - Shared libraries resolved from: ECC/scripts/lib/ (utils.js, hook-flags.js, state-store/)
#
# IMPORTANT: Per AGENTS.md §11, upstream ECC scripts and shared libraries MUST NOT
# be copied or mirrored into .agents/hooks/ or .agents/hooks/lib/. They must be
# referenced strictly in-place via this CLAUDE_PLUGIN_ROOT variable.
CLAUDE_PLUGIN_ROOT=d:/dev/agy-os/ECC

# ------------------------------------------------------------------------------
# Runtime Configuration Variables
# ------------------------------------------------------------------------------

# Active hook profile controlling which lifecycle hook execution chains are active.
# Options: standard | minimal | debug
ECC_HOOK_PROFILE=standard

# Enable governance audit capture for secret scanning and policy enforcement hooks.
# 1 = enabled, 0 = disabled
ECC_GOVERNANCE_CAPTURE=1

# Comma-separated list of hook IDs to disable at runtime (e.g., stop:cost-tracker,pre:config-protection).
# Leave empty to keep all profile hooks enabled.
ECC_DISABLED_HOOKS=

# Active session tracking identifier for telemetry and context compaction hooks.
# Leave empty to auto-generate a unique session tracking ID.
ECC_SESSION_ID=
