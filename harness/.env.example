# ==============================================================================
# Antigravity Harness Environment Configuration Template
# ==============================================================================
# This template documents runtime environment variables for hook profile selection,
# governance audit capture, and session tracking within the agy-os harness.
#
# 100% SELF-CONTAINED SCRIPT ARCHITECTURE:
# Per AGENTS.md §11 and OBJ-03 Spec, all runtime hook scripts, support scripts,
# and shared libraries are physically co-located in .agents/scripts/ and
# .agents/scripts/lib/. Zero external environment variables (such as CLAUDE_PLUGIN_ROOT)
# are required for script execution.
#
# Copy this file to '.env' in the harness root (d:/dev/agy-os/.env) if custom flags are needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Optional Runtime Configuration Variables
# ------------------------------------------------------------------------------

# Active hook profile controlling which lifecycle hook execution chains are active.
# Options: standard | minimal | debug
ECC_HOOK_PROFILE=standard

# Enable governance audit capture for secret scanning and policy enforcement hooks.
# 1 = enabled, 0 = disabled
ECC_GOVERNANCE_CAPTURE=1

# Comma-separated list of hook IDs to disable at runtime (e.g., stop:cost-tracker,pre:config-protection).
# Leave empty to keep all profile hooks enabled.
ECC_DISABLED_HOOKS=

# Active session tracking identifier for telemetry and context compaction hooks.
# Leave empty to auto-generate a unique session tracking ID.
ECC_SESSION_ID=
